# Copy to .env (gitignored) and fill in.
# wrangler picks these up automatically when running deploy.

# Cloudflare account ID — required by `wrangler deploy`.
# Find it in the Cloudflare dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=

# Optional: API token if not using interactive `wrangler login`.
# Needs Workers Scripts + Workers Subdomain edit + Account Read.
# CLOUDFLARE_API_TOKEN=
