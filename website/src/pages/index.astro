---
// Dew landing page — Loopwise design system, ink/lime, Geist Sans + Mono.
// Original prototype from dewvm/project/Dew Landing.html (handoff bundle).
// Production cuts: 2 alternate hero variants dropped (kept "split" — the
// default); dev-only tweaks panel + React UMD + Babel scripts dropped.

import '../styles/tokens.css'
import '../styles/site.css'

// Build-time fetch — bake current GitHub state into the static output so the
// page doesn't need SSR. Re-run on every dew release via CI to refresh.
// Defaults gracefully if the API call fails (rate limit, network, repo private).
async function repoMeta() {
  try {
    const [release, repo] = await Promise.all([
      fetch('https://api.github.com/repos/solcreek/dew/releases/latest', {
        headers: { 'User-Agent': 'dewvm-website-build' },
      }).then((r) => (r.ok ? r.json() : null)),
      fetch('https://api.github.com/repos/solcreek/dew', {
        headers: { 'User-Agent': 'dewvm-website-build' },
      }).then((r) => (r.ok ? r.json() : null)),
    ])
    return {
      version: release?.tag_name ?? 'v0.5.1',
      stars: repo?.stargazers_count ?? 0,
    }
  } catch {
    return { version: 'v0.5.1', stars: 0 }
  }
}

const { version, stars } = await repoMeta()
